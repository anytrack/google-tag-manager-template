___TESTS___

scenarios:
  - name: Should create a valid URL from the PropertyID value
    code: |-
      // Should create a valid URL from the PropertyID value
      let injectedUrl;
      mock('injectScript', (url, onSuccess) => {
        injectedUrl = url;
        onSuccess();
      });

      const mockData = {
        PropertyID: 'kkEEssDDAA00'
      };

      runCode(mockData);

      assertApi('encodeUri').wasCalledWith(mockData.PropertyID);
      assertThat(injectedUrl).isEqualTo('https://assets.anytrack.io/kkEEssDDAA00.js');

  - name: Initial setConsent sends all Consent Mode v2 fields
    code: |-
      // Initial setConsent sends all Consent Mode v2 fields
      const consent = {
        ad_storage: false,
        analytics_storage: true,
        ad_user_data: false,
        ad_personalization: true
      };

      mock('isConsentGranted', (consentType) => consent[consentType]);
      mock('injectScript', (url, onSuccess) => onSuccess());

      runCode({PropertyID: 'FTIi3VHkszpA'});

      assertApi('createArgumentsQueue').wasCalledWith('AnyTrack', 'AnyTrack.q');
      assertApi('callInWindow').wasCalledWith('AnyTrack', 'setConsent', {
        ad_storage: false,
        analytics_storage: true,
        ad_user_data: false,
        ad_personalization: true
      });

  - name: Denied to granted sends an updated full consent snapshot
    code: |-
      // Denied to granted sends an updated full consent snapshot
      const consent = {
        ad_storage: false,
        analytics_storage: false,
        ad_user_data: false,
        ad_personalization: false
      };
      const listeners = {};
      const scheduledCallbacks = [];

      mock('isConsentGranted', (consentType) => consent[consentType]);
      mock('addConsentListener', (consentType, listener) => {
        listeners[consentType] = listener;
      });
      mock('callLater', (callback) => {
        scheduledCallbacks.push(callback);
      });
      mock('injectScript', (url, onSuccess) => onSuccess());

      runCode({PropertyID: 'FTIi3VHkszpA'});

      consent.ad_user_data = true;
      listeners.ad_user_data('ad_user_data', true);
      consent.analytics_storage = true;
      listeners.analytics_storage('analytics_storage', true);

      assertThat(listeners.ad_storage).isFunction();
      assertThat(listeners.analytics_storage).isFunction();
      assertThat(listeners.ad_user_data).isFunction();
      assertThat(listeners.ad_personalization).isFunction();
      assertThat(scheduledCallbacks).hasLength(1);
      scheduledCallbacks[0]();
      assertApi('callInWindow').wasCalledWith('AnyTrack', 'setConsent', {
        ad_storage: false,
        analytics_storage: true,
        ad_user_data: true,
        ad_personalization: false
      });
      assertApi('callInWindow').wasNotCalledWith('AnyTrack', 'setConsent', {ad_user_data: true});

  - name: Granted to denied sends an updated full consent snapshot
    code: |-
      // Granted to denied sends an updated full consent snapshot
      const consent = {
        ad_storage: true,
        analytics_storage: true,
        ad_user_data: true,
        ad_personalization: true
      };
      const listeners = {};

      mock('isConsentGranted', (consentType) => consent[consentType]);
      mock('addConsentListener', (consentType, listener) => {
        listeners[consentType] = listener;
      });
      mock('callLater', (callback) => callback());
      mock('injectScript', (url, onSuccess) => onSuccess());

      runCode({PropertyID: 'FTIi3VHkszpA'});

      consent.ad_storage = false;
      listeners.ad_storage('ad_storage', false);

      assertApi('callInWindow').wasCalledWith('AnyTrack', 'setConsent', {
        ad_storage: false,
        analytics_storage: true,
        ad_user_data: true,
        ad_personalization: true
      });
      assertApi('callInWindow').wasNotCalledWith('AnyTrack', 'setConsent', {ad_storage: false});

  - name: ad_user_data reads ad_user_data consent
    code: |-
      // ad_user_data reads ad_user_data consent
      const consent = {
        ad_storage: true,
        analytics_storage: true,
        ad_user_data: false,
        ad_personalization: true
      };

      mock('isConsentGranted', (consentType) => consent[consentType]);
      mock('injectScript', (url, onSuccess) => onSuccess());

      runCode({PropertyID: 'FTIi3VHkszpA'});

      assertApi('isConsentGranted').wasCalledWith('ad_user_data');
      assertApi('callInWindow').wasCalledWith('AnyTrack', 'setConsent', {
        ad_storage: true,
        analytics_storage: true,
        ad_user_data: false,
        ad_personalization: true
      });

  - name: Queues GTM template installer metadata before loading the tracking script
