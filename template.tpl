___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const propertyId = data.PropertyID;
const encodeUri = require('encodeUri');
const injectScript = require('injectScript');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');
const callInWindow = require('callInWindow');
const callLater = require('callLater');
const createArgumentsQueue = require('createArgumentsQueue');

createArgumentsQueue('AnyTrack', 'AnyTrack.q');
callInWindow('AnyTrack', {
  il: {
    im: 'gtm-template',
  },
});

const getConsentSnapshot = () => ({
  ad_storage: isConsentGranted('ad_storage'),
  analytics_storage: isConsentGranted('analytics_storage'),
  ad_user_data: isConsentGranted('ad_user_data'),
  ad_personalization: isConsentGranted('ad_personalization'),
});

let consentSyncQueued = false;

const syncConsent = () => {
  consentSyncQueued = false;
  callInWindow('AnyTrack', 'setConsent', getConsentSnapshot());
};

const scheduleConsentSync = () => {
  if (consentSyncQueued) {
    return;
  }

  consentSyncQueued = true;
  callLater(syncConsent);
};

addConsentListener('ad_storage', scheduleConsentSync);
addConsentListener('analytics_storage', scheduleConsentSync);
addConsentListener('ad_user_data', scheduleConsentSync);
addConsentListener('ad_personalization', scheduleConsentSync);

syncConsent();

const url = 'https://assets.anytrack.io/' + encodeUri(propertyId) + '.js';
injectScript(
  url,
  () => {
    syncConsent();
    data.gtmOnSuccess();
  },
  data.gtmOnFailure,
  'AnyTrack'
);


